// Prisma schema untuk portfolio
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id @default(cuid())
  title           String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  category        String   @db.VarChar(100)
  description     String   @db.Text
  longDescription String?  @map("long_description") @db.Text
  techStack       Json     @map("tech_stack") // array of strings
  challenge       String?  @db.Text
  solution        String?  @db.Text
  impact          String?  @db.Text
  demoUrl         String?  @map("demo_url") @db.VarChar(500)
  demoVideoUrl    String?  @map("demo_video_url") @db.VarChar(500)
  githubUrl       String?  @map("github_url") @db.VarChar(500)
  featured        Boolean  @default(false)
  imageUrls       Json     @map("image_urls") // array of relative paths
  year            String?  @db.VarChar(20)
  role            String?  @db.VarChar(100)
  timeline        String?  @db.VarChar(100)
  status          String?  @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([featured])
  @@index([category])
  @@index([createdAt])
  @@map("projects")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("admin_users")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String   @map("ip_address") @db.VarChar(64)
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  message   String   @db.Text
  ipAddress String   @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("contact_submissions")
}
